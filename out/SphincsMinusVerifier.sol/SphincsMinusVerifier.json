0:547;2965:6;2960:3;2953:19;3002:6;2997:2;2992:3;2988:12;2981:28;2935:3;3038:6;3032:13;3063:1;3073:134;3087:6;3084:1;3081:13;3073:134;;;3192:2;3176:14;;;3172:23;;3166:30;3161:2;3148:11;;;3144:20;3137:60;3102:10;3073:134;;;-1:-1:-1;3271:1:21;3230:16;;3248:2;3226:25;3260:13;;;-1:-1:-1;3226:25:21;2750:547;-1:-1:-1;;;2750:547:21:o","linkReferences":{}},"methodIdentifiers":{"verify(bytes32,bytes32,bytes32,bytes)":"2bf6eda8","verifyReadable(bytes32,bytes32,bytes32,bytes)":"35bc7d1c"},"rawMetadata":"{\"compiler\":{\"version\":\"0.8.28+commit.7893614a\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[],\"name\":\"InvalidPublicKey\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"InvalidSignatureLength\",\"type\":\"error\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"pkSeed\",\"type\":\"bytes32\"},{\"internalType\":\"bytes32\",\"name\":\"pkRoot\",\"type\":\"bytes32\"},{\"internalType\":\"bytes32\",\"name\":\"message\",\"type\":\"bytes32\"},{\"internalType\":\"bytes\",\"name\":\"sig\",\"type\":\"bytes\"}],\"name\":\"verify\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"valid\",\"type\":\"bool\"}],\"stateMutability\":\"pure\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"pkSeed\",\"type\":\"bytes32\"},{\"internalType\":\"bytes32\",\"name\":\"pkRoot\",\"type\":\"bytes32\"},{\"internalType\":\"bytes32\",\"name\":\"message\",\"type\":\"bytes32\"},{\"internalType\":\"bytes\",\"name\":\"sig\",\"type\":\"bytes\"}],\"name\":\"verifyReadable\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"valid\",\"type\":\"bool\"}],\"stateMutability\":\"pure\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{\"verify(bytes32,bytes32,bytes32,bytes)\":{\"details\":\"Optimized single-pass implementation: one inline-assembly block,      fixed scratch slots (0x00 seed, 0x20 ADRS, 0x40/0x60 payload),      branchless Merkle swaps, no memory allocation. Semantically      identical to {verifyReadable}; differential fuzzing keeps the two      in lockstep. All exits are in-assembly return/revert, so clobbering      the free-memory pointer is sound (do NOT mark memory-safe).\",\"returns\":{\"valid\":\"true iff the signature is well-formed AND authentic.\"}}},\"title\":\"SphincsMinusVerifier \\u2014 SPHINCS- C13 signature verification (independent implementation)\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"verify(bytes32,bytes32,bytes32,bytes)\":{\"notice\":\"Verify a C13 signature over `message` against (pkSeed, pkRoot).\"},\"verifyReadable(bytes32,bytes32,bytes32,bytes)\":{\"notice\":\"Readable reference implementation \\u2014 kept as the differential         oracle for {verify}. Same semantics, ~6\\u00d7 more gas.\"}},\"notice\":\"Verifies SPHINCS- \\\"C13\\\" signatures: a stateless hash-based post-quantum         scheme derived from SPHINCS+/SLH-DSA (FIPS 205), instantiated with         keccak256 instead of SHAKE256 and sized for wallet-scale signature budgets.         Parameter set C13 (see ethresear.ch post, June 2026, nconsigny):           n=16, h=22, d=2, subtree_h=11, k=7, a=19, w=8, l=43, target_sum=208           signature size: 3688 bytes         This implementation prioritizes auditability over gas. It follows the         FIPS 205 \\u00a74.2 uncompressed 32-byte ADRS layout with keccak256 substituted         for SHAKE256. Correctness gate: must accept signatures produced by the         reference signer and reject mutated ones.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/verifiers/SphincsMinusVerifier.sol\":\"SphincsMinusVerifier\"},\"evmVersion\":\"shanghai\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":forge-std/=lib/forge-std/src/\"]},\"sources\":{\"src/verifiers/SphincsMinusVerifier.sol\":{\"keccak256\":\"0x51256e8537a5fcd8b3ba2d8639f7538b2f793d91697f6c4c260bb52c2a11b2d9\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://15ad6da5c33e0b41bbaeacaf456d08d7cf28348340b11cfcbcaaf04a061044cc\",\"dweb:/ipfs/QmQgsHB3X3PoZJmNDh6EKF3QWLiEVbdUmicEWvPuBimRQe\"]}},\"version\":1}","metadata":{"compiler":{"version":"0.8.28+commit.7893614a"},"language":"Solidity","output":{"abi":[{"inputs":[],"type":"error","name":"InvalidPublicKey"},{"inputs":[],"type":"error","name":"InvalidSignatureLength"},{"inputs":[{"internalType":"bytes32","name":"pkSeed","type":"bytes32"},{"internalType":"bytes32","name":"pkRoot","type":"bytes32"},{"internalType":"bytes32","name":"message","type":"bytes32"},{"internalType":"bytes","name":"sig","type":"bytes"}],"stateMutability":"pure","type":"function","name":"verify","outputs":[{"internalType":"bool","name":"valid","type":"bool"}]},{"inputs":[{"internalType":"bytes32","name":"pkSeed","type":"bytes32"},{"internalType":"bytes32","name":"pkRoot","type":"bytes32"},{"internalType":"bytes32","name":"message","type":"bytes32"},{"internalType":"bytes","name":"sig","type":"bytes"}],"stateMutability":"pure","type":"function","name":"verifyReadable","outputs":[{"internalType":"bool","name":"valid","type":"bool"}]}],"devdoc":{"kind":"dev","methods":{"verify(bytes32,bytes32,bytes32,bytes)":{"details":"Optimized single-pass implementation: one inline-assembly block,      fixed scratch slots (0x00 seed, 0x20 ADRS, 0x40/0x60 payload),      branchless Merkle swaps, no memory allocation. Semantically      identical to {verifyReadable}; differential fuzzing keeps the two      in lockstep. All exits are in-assembly return/revert, so clobbering      the free-memory pointer is sound (do NOT mark memory-safe).","returns":{"valid":"true iff the signature is well-formed AND authentic."}}},"version":1},"userdoc":{"kind":"user","methods":{"verify(bytes32,bytes32,bytes32,bytes)":{"notice":"Verify a C13 signature over `message` against (pkSeed, pkRoot)."},"verifyReadable(bytes32,bytes32,bytes32,bytes)":{"notice":"Readable reference implementation — kept as the differential         oracle for {verify}. Same semantics, ~6× more gas."}},"version":1}},"settings":{"remappings":["forge-std/=lib/forge-std/src/"],"optimizer":{"enabled":true,"runs":200},"metadata":{"bytecodeHash":"ipfs"},"compilationTarget":{"src/verifiers/SphincsMinusVerifier.sol":"SphincsMinusVerifier"},"evmVersion":"shanghai","libraries":{}},"sources":{"src/verifiers/SphincsMinusVerifier.sol":{"keccak256":"0x51256e8537a5fcd8b3ba2d8639f7538b2f793d91697f6c4c260bb52c2a11b2d9","urls":["bzz-raw://15ad6da5c33e0b41bbaeacaf456d08d7cf28348340b11cfcbcaaf04a061044cc","dweb:/ipfs/QmQgsHB3X3PoZJmNDh6EKF3QWLiEVbdUmicEWvPuBimRQe"],"license":"MIT"}},"version":1},"id":19}